package com.coforge;

public class ComplexNumber {

    double real;
    double imag;

    public ComplexNumber() {
        this.real = 0;
        this.imag = 0;
    }

    public ComplexNumber(double real, double imag) {
        this.real = real;
        this.imag = imag;
    }
}