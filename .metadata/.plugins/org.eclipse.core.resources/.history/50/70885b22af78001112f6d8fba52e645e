package com.coforge;


public class Even {
    public static void main(String[] args) {
        int[] arr = {12, 7, 8, 3, 24, 15, 6};
        
        System.out.println("Even numbers:");
        for (int num : arr) {
            if (num % 2 == 0)
                System.out.println(num);
        }
    }
}
